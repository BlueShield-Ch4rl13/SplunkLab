# Copia este fichero a .env:   cp .env.example .env

# Contraseña de admin en Splunk. Mínimo 8 caracteres.
SPLUNK_PASSWORD=CAMBIA_LA_CONTRASEÑA

# Token de HEC. Tiene que ser EL MISMO que aparece en
# splunk/apps/mi_indice/default/inputs.conf  (stanza [http://mi_servicio]).
# Si lo cambias, cámbialo en los dos sitios.
HEC_TOKEN=11112222-3333-4444-5555-666677778888

# Puertos publicados en tu máquina
SPLUNK_WEB_PORT=8000
SPLUNK_HEC_PORT=8088
SPLUNK_MGMT_PORT=8089
SERVICIO_PORT=8080

# Versión de la imagen de Splunk (fija una concreta si quieres reproducibilidad)
SPLUNK_TAG=latest
