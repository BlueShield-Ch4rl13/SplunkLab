# No hace falta copiarlo a mano: "make up" crea el .env la primera vez y
# genera una contraseña y un token de HEC aleatorios (scripts/generar-secretos.sh).
# Si los dejas vacíos aquí, se generan; si pones los tuyos, se respetan.

# Contraseña de admin en Splunk. Mínimo 8 caracteres. Vacía = se genera.
SPLUNK_PASSWORD=

# Token de HEC. Vacío = se genera un UUID. El script lo escribe también en
# splunk/apps/mi_indice/local/inputs.conf (que no se sube al repositorio).
HEC_TOKEN=

# Dirección en la que se publican los puertos. 127.0.0.1 = solo esta máquina.
# Para entrar desde otro equipo de la red (MANUAL.md) pon 0.0.0.0 sabiendo que
# entonces cualquiera de la LAN llega al login de Splunk y a la API.
SPLUNK_BIND=127.0.0.1

# Puertos publicados en tu máquina
SPLUNK_WEB_PORT=8000
SPLUNK_HEC_PORT=8088
SPLUNK_MGMT_PORT=8089
SERVICIO_PORT=8080

# Versión de la imagen de Splunk (y del Universal Forwarder). Fijada a una 10.0.x
# concreta para que el lab sea reproducible y no salte de versión mayor solo.
# 10.0.12 (30/10/2026) es la última de la rama 10.0: corrige CVE-2026-20253
# (9,8, sin autenticación, en el catálogo KEV de CISA; afecta a 10.0.0-10.0.6) y
# los avisos de octubre (SVD-2026-1001/1002). scripts/generar-secretos.sh sube
# sola una 10.0.x anterior a esta. Para subir de versión, ver MANUAL.md.
SPLUNK_TAG=10.0.12
